{
  "name": "@deepseek-ai/dsh-tui-app",
  "description": "Interactive terminal surface over the same SessionController and per-session presets as the Web app",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/tui-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "node_modules/@deepseek-ai/dsh-web-app/presets/standard.patch.yml",
    "node_modules/@deepseek-ai/dsh-web-app/presets/ptc.patch.yml",
    "node_modules/@deepseek-ai/dsh-web-app/presets/minimal.patch.yml",
    "node_modules/@deepseek-ai/dsh-web-app/presets/cordis.patch.yml",
    "lib/rolldown-runtime-*.js",
    "lib/devtools-*.js",
    "assets",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./node_modules/@deepseek-ai/dsh-web-app/presets/standard.patch.yml",
        "./node_modules/@deepseek-ai/dsh-web-app/presets/ptc.patch.yml",
        "./node_modules/@deepseek-ai/dsh-web-app/presets/minimal.patch.yml",
        "./node_modules/@deepseek-ai/dsh-web-app/presets/cordis.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-instructions": "workspace:*",
    "@deepseek-ai/dsh-agent-preset": "workspace:*",
    "@deepseek-ai/dsh-agent-preset-registry": "workspace:*",
    "@deepseek-ai/dsh-api-job-controller": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-client-file-upload": "workspace:*",
